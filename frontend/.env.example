# Mode login: "sso" (produksi, CAS PNJ), "dev" (backend lokal Laravel, pilih peran, APP_ENV=local), atau "mock" (tanpa backend)
VITE_AUTH_MODE=mock
# Alamat backend Laravel (dipakai saat VITE_AUTH_MODE=sso atau VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8000
# true = data tiruan dari src/data/mock.js, false = panggil API Laravel
VITE_USE_MOCK=true
